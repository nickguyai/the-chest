// Kaizen OS Database Schema V4
// PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum TaskStatus {
  in_progress
  not_started
  completed
  backlog
}

enum UnitType {
  THEME
  ACTION_GATE
  ACTION_EXPERIMENT
  ACTION_ROUTINE
  ACTION_OPS
  TASK
  VETO
}

enum EventType {
  gate_started
  gate_completed
  gate_failed
  experiment_started
  experiment_completed
  experiment_failed
  experiment_pivoted
  criteria_graded
  routine_started
  routine_replaced
  ops_started
  ops_completed
  veto_added
  veto_violated
  time_logged
  week_planned
  season_started
  season_ended
  agent_mutation
}

// Users table (simplified for MVP)
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cards         Card[]
  seasons       Season[]
  events        Event[]
  agentSessions AgentSession[]

  @@map("users")
}

// Agent sessions for multi-turn chat
model AgentSession {
  id            String   @id @default(uuid())
  claudeSession String   @unique @map("claude_session_id")
  userId        Int      @map("user_id")
  title         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AgentMessage[]

  @@index([userId])
  @@map("agent_sessions")
}

model AgentMessage {
  id             Int      @id @default(autoincrement())
  sessionId      String   @map("session_id")
  role           String
  content        String   @db.Text
  checkpointUuid String?  @map("checkpoint_uuid")
  createdAt      DateTime @default(now()) @map("created_at")

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("agent_messages")
}


// Cards - unified table for themes, gates, experiments, routines, ops, tasks, vetoes
model Card {
  id             Int        @id @default(autoincrement())
  userId         Int        @map("user_id")
  parentId       Int?       @map("parent_id")
  title          String     @db.VarChar(255)
  description    String?    @db.Text
  targetDate     DateTime?  @map("target_date") @db.Date
  completionDate DateTime?  @map("completion_date") @db.Date
  startDate      DateTime?  @map("start_date") @db.Date
  status         TaskStatus @default(not_started)
  unitType       UnitType   @map("unit_type")
  seasonId       Int?       @map("season_id")
  lagWeeks       Int?       @map("lag_weeks")
  criteria       String[]   @default([])
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  // Relations
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Card?   @relation("CardHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Card[]  @relation("CardHierarchy")
  season   Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  events   Event[]

  @@index([userId, unitType], name: "idx_cards_user_type")
  @@index([userId, parentId], name: "idx_cards_user_parent")
  @@index([userId, status], name: "idx_cards_user_status")
  @@index([seasonId], name: "idx_cards_season")
  @@index([targetDate], name: "idx_cards_target_date")
  @@map("cards")
}

// Seasons - time-boxed planning periods
model Season {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  name             String   @db.VarChar(100)
  startDate        DateTime @map("start_date") @db.Date
  durationWeeks    Int      @map("duration_weeks")
  utilityRate      Float    @default(40.0) @map("utility_rate")
  themeAllocations Json     @default("{}") @map("theme_allocations") // { [themeId]: allocation (0-1) }
  isActive         Boolean  @default(false) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([userId], name: "idx_seasons_user")
  @@index([userId], name: "idx_seasons_user_active")
  @@map("seasons")
}

// Events - append-only event log for event sourcing
// Also used for time tracking via 'time_logged' event type
model Event {
  id             BigInt    @id @default(autoincrement())
  userId         Int       @map("user_id")
  eventType      EventType @map("event_type")
  cardId         Int?      @map("card_id")
  payload        Json      @default("{}")
  occurredAt     DateTime  @default(now()) @map("occurred_at")
  idempotencyKey String?   @map("idempotency_key") @db.VarChar(255)

  // Relations
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey], name: "idx_events_idempotency")
  @@index([userId, eventType], name: "idx_events_user_type")
  @@index([userId, cardId], name: "idx_events_user_card")
  @@index([userId, occurredAt(sort: Desc)], name: "idx_events_user_time")
  @@map("events")
}
