    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-query": "^5.60.0",
    "@types/luxon": "^3.7.1",
    "animejs": "^4.2.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.0",
    "googleapis": "^169.0.0",
    "luxon": "^3.7.2",
    "react": "^18.3.1",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.0"
